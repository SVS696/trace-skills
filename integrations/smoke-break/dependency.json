      "reminder_prefix": "Smoke break:"
    },
    "claude": {
      "plugin_id": "smoke-break@trace-smoke-break",
      "distribution": "bundled-adapter",
      "expected_version": "0.1.0-trace.2",
      "marker_path": "hooks/smoke-break.mjs",
      "reminder_prefix": "Smoke break:",
      "plugin_path": "integrations/smoke-break/claude-marketplace/plugins/smoke-break"
    }
  }
}
